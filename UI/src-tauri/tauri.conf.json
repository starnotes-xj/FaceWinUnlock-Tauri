{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "facewinunlock-tauri",
  "version": "0.5.10",
  "identifier": "com.administrator.facewinunlock-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FaceWinUnlock-Tauri 星记Fork版本",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/FaceWinUnlock-Server.exe": "resources/FaceWinUnlock-Server.exe",
      "../../target/release/FaceWinUnlock-Launcher.exe": "resources/FaceWinUnlock-Launcher.exe",
      "../../target/release/FaceWinUnlock-Passkey.msix": "FaceWinUnlock-Passkey.msix",
      "../../target/release/FaceWinUnlock-Passkey.cer": "FaceWinUnlock-Passkey.cer",
      "../../scripts/install-passkey-plugin.ps1": "scripts/install-passkey-plugin.ps1",
      "../../scripts/uninstall-passkey-plugin.ps1": "scripts/uninstall-passkey-plugin.ps1",
      "./nsis/cleanup_tiles.ps1": "nsis/cleanup_tiles.ps1",
      "./nsis/resilience.ps1": "nsis/resilience.ps1",
      "../../target/release/FaceWinUnlock_Tauri.dll": "resources/FaceWinUnlock-Tauri.dll",
      "../resources/anti_spoof_mn3.LICENSE.txt": "resources/anti_spoof_mn3.LICENSE.txt",
      "../resources/anti_spoof_mn3.bin": "resources/anti_spoof_mn3.bin",
      "../resources/anti_spoof_mn3.onnx": "resources/anti_spoof_mn3.onnx",
      "../resources/anti_spoof_mn3.xml": "resources/anti_spoof_mn3.xml",
      "../resources/face_detection_yunet_2023mar.bin": "resources/face_detection_yunet_2023mar.bin",
      "../resources/face_detection_yunet_2023mar.onnx": "resources/face_detection_yunet_2023mar.onnx",
      "../resources/face_detection_yunet_2023mar.xml": "resources/face_detection_yunet_2023mar.xml",
      "../resources/face_liveness.onnx": "resources/face_liveness.onnx",
      "../resources/face_liveness_mini_fasnet_v2.bin": "resources/face_liveness_mini_fasnet_v2.bin",
      "../resources/face_liveness_mini_fasnet_v2.onnx": "resources/face_liveness_mini_fasnet_v2.onnx",
      "../resources/face_liveness_mini_fasnet_v2.xml": "resources/face_liveness_mini_fasnet_v2.xml",
      "../resources/face_recognition_sface_2021dec.bin": "resources/face_recognition_sface_2021dec.bin",
      "../resources/face_recognition_sface_2021dec.onnx": "resources/face_recognition_sface_2021dec.onnx",
      "../resources/face_recognition_sface_2021dec.xml": "resources/face_recognition_sface_2021dec.xml",
      "D:\\OpenCV\\build\\x64\\vc16\\bin\\opencv_world4120.dll": "resources/opencv_world4120.dll",
      "D:\\OpenCV\\openvino_runtime\\": "."
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./nsis/hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
